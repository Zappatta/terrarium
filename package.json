{
  "name": "terrarium",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "match": "tsx scripts/run-match.ts",
    "balance": "tsx scripts/balance.ts",
    "server": "node --disable-warning=ExperimentalWarning --import tsx packages/server/src/main.ts",
    "demo": "TERRARIUM_DEMO=1 TERRARIUM_DEV_LOGIN=1 TERRARIUM_ADMINS=${TERRARIUM_ADMINS:-admin@dev.local} node --disable-warning=ExperimentalWarning --import tsx packages/server/src/main.ts"
  },
  "devDependencies": {
    "@terrarium/engine": "workspace:^",
    "@terrarium/sandbox": "workspace:^",
    "@terrarium/sdk": "workspace:^",
    "@terrarium/server": "workspace:^",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
